{
    "manifest_version": 3,
    "name": "EForm Auto Fill",
    "version": "5.0.0",
    "description": "EForm Noibo — Sheets API direct (1-2s), bypass GAS, 100% tốc độ",
    "permissions": [
        "scripting",
        "activeTab",
        "storage",
        "tabs",
        "notifications"
    ],
    "host_permissions": [
        "https://noibo.ghn.vn/*",
        "https://sheets.googleapis.com/*",
        "https://oauth2.googleapis.com/*",
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://sheets.googleapis.com https://oauth2.googleapis.com https://noibo.ghn.vn https://script.google.com https://script.googleusercontent.com"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "EForm Auto Fill v5.0"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://noibo.ghn.vn/eform/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}